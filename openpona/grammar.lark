// OpenPona structural grammar = canon/04_grammar.md section 3 (single mode).
// Precedence, loosest to tightest: la > li > e/tan > anu > pi.
// Only `tan` is both structural and a unit; li la e pi anu are never units.
// Input is a space-joined token stream; META folds arrive as D<n>(P) units, or
// (reference parser, 2026-10-09) as RUN_<L> spans: every token of a repetition run
// carries `<L` on its first and `>L` on its last word, so ONE parse holds the folded
// and the unfolded readings (META fold fallback, SPEC 7 / invariant 18).

start: statement

statement: clause | clause LA clause | TAN expression LA clause

clause: expression | expression lis

// C2: a predicate containing anu must be the last one (anu in the subject is fine).
lis: LI predicate_na lis | LI predicate

// C3: objects (e) before source phrases (tan).  C8: a predicate may start with tan.
predicate: expression
         | expression objs
         | expression tans
         | expression objs tans
         | tanpred

tanpred: TAN expression | TAN expression tans

objs: obj | obj objs

obj: E expression

tans: tanp | tanp tans

tanp: TAN expression

// anu-free twins of the predicate rules (phrases only)
predicate_na: phrase
            | phrase objs_na
            | phrase tans_na
            | phrase objs_na tans_na
            | tanpred_na

tanpred_na: TAN phrase | TAN phrase tans_na

objs_na: obj_na | obj_na objs_na

obj_na: E phrase

tans_na: tanp_na | tanp_na tans_na

tanp_na: TAN phrase

expression: phrase | phrase ANU expression

phrase: head | head groups

groups: group | group groups

group: PI unit unit

head: unit | unit unit

unit: SEM | TAN | META | RUN_A | RUN_B | RUN_C | RUN_D | RUN_E | RUN_F

LA: /(?<!\S)la(?!\S)/
LI: /(?<!\S)li(?!\S)/
E: /(?<!\S)e(?!\S)/
TAN: /(?<!\S)tan(?:[<>][A-F])*(?!\S)/
PI: /(?<!\S)pi(?!\S)/
ANU: /(?<!\S)anu(?!\S)/
SEM: /(?<!\S)(?!(?:la|li|e|tan|pi|anu)(?![a-z]))[a-z]+(?:[<>][A-F])*(?!\S)/
META: /D\d+\((?!(?:la|li|e|pi|anu)[ )])[a-z]+(?: (?!(?:la|li|e|pi|anu)\))[a-z]+)?\)/

// One whole repetition run read as a single META unit (label L, see header).
RUN_A: /(?<!\S)[a-z]+(?:[<>][A-F])*<A(?:[<>][A-F])*(?: \S+)*? [a-z]+(?:[<>][A-F])*>A(?:[<>][A-F])*(?!\S)/
RUN_B: /(?<!\S)[a-z]+(?:[<>][A-F])*<B(?:[<>][A-F])*(?: \S+)*? [a-z]+(?:[<>][A-F])*>B(?:[<>][A-F])*(?!\S)/
RUN_C: /(?<!\S)[a-z]+(?:[<>][A-F])*<C(?:[<>][A-F])*(?: \S+)*? [a-z]+(?:[<>][A-F])*>C(?:[<>][A-F])*(?!\S)/
RUN_D: /(?<!\S)[a-z]+(?:[<>][A-F])*<D(?:[<>][A-F])*(?: \S+)*? [a-z]+(?:[<>][A-F])*>D(?:[<>][A-F])*(?!\S)/
RUN_E: /(?<!\S)[a-z]+(?:[<>][A-F])*<E(?:[<>][A-F])*(?: \S+)*? [a-z]+(?:[<>][A-F])*>E(?:[<>][A-F])*(?!\S)/
RUN_F: /(?<!\S)[a-z]+(?:[<>][A-F])*<F(?:[<>][A-F])*(?: \S+)*? [a-z]+(?:[<>][A-F])*>F(?:[<>][A-F])*(?!\S)/

WS: /\s+/
%ignore WS
