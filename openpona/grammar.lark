// OpenPona structural grammar = canon/04_grammar.md section 3 (single mode).
// Precedence, loosest to tightest: la > li > e/tan > anu > pi.
// Only `tan` is both structural and a unit; li la e pi anu are never units.
// Input is a space-joined token stream; META folds arrive as D<n>(P) units.

start: statement

statement: clause | clause LA clause

clause: expression | expression lis

lis: LI predicate | LI predicate lis

predicate: expression | expression parts

parts: part | part parts

part: E expression | TAN expression

expression: phrase | phrase ANU expression

phrase: head | head groups

groups: group | group groups

group: PI unit unit

head: unit | unit unit

unit: SEM | TAN | META

LA: /(?<!\S)la(?!\S)/
LI: /(?<!\S)li(?!\S)/
E: /(?<!\S)e(?!\S)/
TAN: /(?<!\S)tan(?!\S)/
PI: /(?<!\S)pi(?!\S)/
ANU: /(?<!\S)anu(?!\S)/
SEM: /(?<!\S)(?!(?:la|li|e|tan|pi|anu)(?!\S))[a-z]+(?!\S)/
META: /D\d+\((?!(?:la|li|e|pi|anu)[ )])[a-z]+(?: (?!(?:la|li|e|pi|anu)\))[a-z]+)?\)/

WS: /\s+/
%ignore WS
